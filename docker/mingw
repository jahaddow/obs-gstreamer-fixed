FROM debian:bookworm

RUN apt-get update \
 && apt-get install -y git meson mingw-w64 mingw-w64-tools msitools ninja-build unzip wget wine xvfb curl \
 && rm -rf /var/lib/apt/lists/*

ENV WINEARCH=win64 \
    WINEDEBUG=-all

ARG OBS_VERSION=32.2.2
ARG GSTREAMER_VERSION=1.26.11

RUN wget https://github.com/obsproject/obs-studio/releases/download/${OBS_VERSION}/OBS-Studio-${OBS_VERSION}-Windows-x64.zip \
 && wget https://github.com/obsproject/obs-studio/archive/refs/tags/${OBS_VERSION}.tar.gz \
 && unzip -q OBS-Studio-${OBS_VERSION}-Windows-x64.zip \
 && tar xzf ${OBS_VERSION}.tar.gz \
 && ln -s obs-studio-${OBS_VERSION}/libobs/ obs \
 && printf '%s\n' \
      '#pragma once' \
      '#define OBS_DATA_PATH "../../data"' \
      '#define OBS_PLUGIN_PATH "../../lib/obs-plugins/64bit"' \
      '#define OBS_PLUGIN_DESTINATION "obs-plugins/64bit"' \
      '#define OBS_INSTALL_PREFIX ""' \
      '#define OBS_RELEASE_CANDIDATE 0' \
      '#define OBS_BETA 0' > /obsconfig.h \
 && rm OBS-Studio-${OBS_VERSION}-Windows-x64.zip \
 && rm ${OBS_VERSION}.tar.gz

COPY .ci-cache/gstreamer/gstreamer-runtime.msi /tmp/gstreamer-runtime.msi
COPY .ci-cache/gstreamer/gstreamer-devel.msi /tmp/gstreamer-devel.msi

RUN mkdir -p /root/.wine/drive_c /tmp/gstreamer-runtime /tmp/gstreamer-devel \
 && ln -s /root/.wine/drive_c /c \
 && msiextract -C /tmp/gstreamer-runtime /tmp/gstreamer-runtime.msi >/dev/null \
 && runtime_root=$(find /tmp/gstreamer-runtime -type d -path '*/gstreamer/1.0/mingw_x86_64' -print -quit) \
 && test -n "$runtime_root" \
 && mkdir -p /c/gstreamer/1.0/mingw_x86_64 \
 && cp -a "$runtime_root"/. /c/gstreamer/1.0/mingw_x86_64/ \
 && msiextract -C /tmp/gstreamer-devel /tmp/gstreamer-devel.msi >/dev/null \
 && devel_root=$(find /tmp/gstreamer-devel -type d -path '*/gstreamer/1.0/mingw_x86_64' -print -quit) \
 && test -n "$devel_root" \
 && cp -a "$devel_root"/. /c/gstreamer/1.0/mingw_x86_64/ \
 && test -f /c/gstreamer/1.0/mingw_x86_64/bin/libgstreamer-1.0-0.dll \
 && test -f /c/gstreamer/1.0/mingw_x86_64/lib/pkgconfig/gstreamer-1.0.pc \
 && sed -i.bak 's#c:/projects/repos/cerbero.git/1.18/build/dist#/c/gstreamer/1.0#i' /c/gstreamer/1.0/mingw_x86_64/lib/pkgconfig/*.pc \
 && rm -rf /tmp/gstreamer-runtime /tmp/gstreamer-devel \
 && rm /tmp/gstreamer-runtime.msi /tmp/gstreamer-devel.msi
