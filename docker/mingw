FROM debian:bookworm

RUN apt-get update \
 && apt-get install -y git meson mingw-w64 mingw-w64-tools ninja-build unzip wget wine curl \
 && rm -rf /var/lib/apt/lists/*

ARG OBS_VERSION=32.2.2
ARG GSTREAMER_VERSION=1.26.11

RUN wget https://github.com/obsproject/obs-studio/releases/download/${OBS_VERSION}/OBS-Studio-${OBS_VERSION}-Windows-x64.zip \
 && wget https://github.com/obsproject/obs-studio/archive/refs/tags/${OBS_VERSION}.tar.gz \
 && unzip OBS-Studio-${OBS_VERSION}-Windows-x64.zip \
 && tar xzvf ${OBS_VERSION}.tar.gz \
 && ln -s obs-studio-${OBS_VERSION}/libobs/ obs \
 && rm OBS-Studio-${OBS_VERSION}-Windows-x64.zip \
 && rm ${OBS_VERSION}.tar.gz

RUN wget https://gstreamer.freedesktop.org/data/pkg/windows/${GSTREAMER_VERSION}/mingw/gstreamer-1.0-devel-mingw-x86_64-${GSTREAMER_VERSION}.msi \
 && wget https://gstreamer.freedesktop.org/data/pkg/windows/${GSTREAMER_VERSION}/mingw/gstreamer-1.0-mingw-x86_64-${GSTREAMER_VERSION}.msi \
 && msiexec -passive -i gstreamer-1.0-mingw-x86_64-${GSTREAMER_VERSION}.msi \
 && msiexec -passive -i gstreamer-1.0-devel-mingw-x86_64-${GSTREAMER_VERSION}.msi \
 && ln -s ~/.wine/drive_c/ /c \
 && rm gstreamer-1.0-mingw-x86_64-${GSTREAMER_VERSION}.msi \
 && rm gstreamer-1.0-devel-mingw-x86_64-${GSTREAMER_VERSION}.msi \
 && sed -i.bak 's/c:\/projects\/repos\/cerbero.git\/1.18\/build\/dist/\/c\/gstreamer\/1.0/i' /c/gstreamer/1.0/mingw_x86_64/lib/pkgconfig/*.pc
